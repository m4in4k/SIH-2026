# MongoDB connection
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=bitcoin_sentinel

# Native (non-Compose) offline installs may point these at local MaxMind DB files.
# Compose uses ./geoip/GeoLite2-Country.mmdb and ./geoip/GeoLite2-ASN.mmdb.
# GEOIP_COUNTRY_DB=/absolute/path/to/GeoLite2-Country.mmdb
# GEOIP_ASN_DB=/absolute/path/to/GeoLite2-ASN.mmdb

# Security & CORS
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000,http://localhost:8080,http://127.0.0.1:8080

# Server configuration
PORT=8000
BIND_ADDRESS=127.0.0.1

# Vercel only: optional bootstrap administrator credentials, created only on a clean database.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.org
# BOOTSTRAP_ADMIN_NAME=Administrator
# BOOTSTRAP_ADMIN_PASSWORD=change_this_password_123

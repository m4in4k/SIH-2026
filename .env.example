# Generate two different URL-safe hex secrets; never commit the real .env.
MONGO_ROOT_PASSWORD=replace_with_a_random_hex_secret
MONGO_APP_PASSWORD=replace_with_a_different_random_hex_secret
BIND_ADDRESS=127.0.0.1
PORT=8080
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Optional: override the default local offline GeoLite2 database paths.
# SENTINEL_GEOIP_COUNTRY_DB=/absolute/path/to/GeoLite2-Country.mmdb
# SENTINEL_GEOIP_ASN_DB=/absolute/path/to/GeoLite2-ASN.mmdb

# Native (non-Compose) offline installs may point these at local MaxMind DB files.
# Compose uses ./geoip/GeoLite2-Country.mmdb and ./geoip/GeoLite2-ASN.mmdb.
# GEOIP_COUNTRY_DB=/absolute/path/to/country.mmdb
# GEOIP_ASN_DB=/absolute/path/to/asn.mmdb

# Vercel only: set these for the first deployment, sign in once, then remove them.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.org
# BOOTSTRAP_ADMIN_NAME=Workspace administrator
# BOOTSTRAP_ADMIN_PASSWORD=replace_with_a_long_random_password
